{
  "kind": "collectionType",
  "collectionName": "customer_profiles",
  "info": {
    "singularName": "customer-profile",
    "pluralName": "customer-profiles",
    "displayName": "CustomerProfile",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "accountType": {
      "type": "enumeration",
      "enum": [
        "private",
        "business"
      ]
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "deliveryAddress": {
      "type": "string"
    },
    "deliveryPostcode": {
      "type": "string"
    },
    "deliveryCity": {
      "type": "string"
    },
    "deliveryCountry": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "businessId": {
      "type": "string"
    },
    "vatNumber": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "billingAddress": {
      "type": "string"
    },
    "billingPostcode": {
      "type": "string"
    },
    "billingCity": {
      "type": "string"
    },
    "billingCountry": {
      "type": "string"
    },
    "deliverySameAsBilling": {
      "type": "boolean",
      "default": false
    },
    "country": {
      "type": "enumeration",
      "enum": [
        "FI-Finland",
        "SE-Sweden",
        "EE-Estonia",
        "LV-Latvia",
        "LT-Lithuania",
        "EU-Other EU",
        "Other"
      ]
    }
  }
}
